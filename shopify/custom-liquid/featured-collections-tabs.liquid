{%- liquid
  # ====== EDIT THESE ======
  assign heading = 'Featured Collections'
  assign subheading = 'Discover our newest arrivals, best sellers, and exclusive offers—all in one place.'
  assign tab_labels = 'Best Sellers|New Arrival|On Sale' | split: '|'
  assign tab_handles = 'best-sellers|new-arrival|on-sale' | split: '|'
  assign products_per_tab = 5
  assign max_swatches = 4
  # ========================
-%}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;700&display=swap" rel="stylesheet">

<style>
  .fct { background:#f7f8fc; padding:40px 0 60px; }
  .fct__inner { max-width:1400px; margin:0 auto; padding:0 16px; }
  .fct__heading { text-align:center; margin:0 0 16px; font-family:'DM Sans',sans-serif; font-size:clamp(16px,2vw,26px); font-weight:400; letter-spacing:-.02em; color:#111; }
  .fct__sub { text-align:center; margin:0 0 40px; font-size:18px; color:#111; }
  .fct__tabs { display:flex; justify-content:center; flex-wrap:wrap; gap:20px; margin-bottom:64px; }
  .fct__tab { padding:12px 20px; border-radius:8px; cursor:pointer; font-size:18px; font-weight:700; text-transform:uppercase; font-family:inherit; background:transparent; border:1px solid #FFEAD7; color:#e8dcc8; transition:background .2s,color .2s; }
  .fct__tab:hover { color:#111; }
  .fct__tab.is-active { background:#FFEAD7; color:#111; }
  .fct__panel { display:none; }
  .fct__panel.is-active { display:block; }
  .fct__grid { display:grid; gap:32px; grid-template-columns:repeat(5,minmax(0,1fr)); }
  .fct__card { text-decoration:none; color:#111; display:block; }
  .fct__media { aspect-ratio:1/1; overflow:hidden; border-radius:20px; background:#f1cfa8; }
  .fct__media img, .fct__media svg { width:100%; height:100%; object-fit:cover; display:block; transition:transform .4s ease; }
  .fct__card:hover .fct__media img { transform:scale(1.04); }
  .fct__info { padding:24px 5px 0; }
  .fct__title { margin:0 0 8px; font-size:22px; font-weight:400; }
  .fct__price { margin:0 0 16px; font-size:16px; }
  .fct__price s { opacity:.5; margin-left:6px; }
  .fct__swatches { display:flex; align-items:center; gap:10px; list-style:none; margin:0; padding:0; }
  .fct__swatch { width:32px; height:32px; border-radius:50%; cursor:pointer; border:1px solid rgba(0,0,0,.15); background-size:cover; background-position:center; }
  .fct__more { font-size:18px; margin-left:4px; }
  @media (max-width:989px) { .fct__grid { grid-template-columns:repeat(3,minmax(0,1fr)); gap:20px; } }
  @media (max-width:749px) {
    .fct__tabs { gap:10px; margin-bottom:32px; }
    .fct__tab { font-size:14px; padding:10px 14px; }
    .fct__grid { grid-template-columns:repeat(2,minmax(0,1fr)); gap:16px; }
    .fct__title { font-size:17px; }
    .fct__swatch { width:24px; height:24px; }
  }
</style>

<div class="fct" id="fct-custom">
  <div class="fct__inner">
    <h2 class="fct__heading">{{ heading }}</h2>
    <p class="fct__sub">{{ subheading }}</p>

    <div class="fct__tabs">
      {%- for label in tab_labels -%}
        <button type="button" class="fct__tab{% if forloop.first %} is-active{% endif %}" data-tab="{{ forloop.index }}">{{ label }}</button>
      {%- endfor -%}
    </div>

    {%- for handle in tab_handles -%}
      {%- assign col = collections[handle] -%}
      <div class="fct__panel{% if forloop.first %} is-active{% endif %}" data-panel="{{ forloop.index }}">
        <div class="fct__grid">
          {%- for product in col.products limit: products_per_tab -%}
            <a href="{{ product.url }}" class="fct__card">
              <div class="fct__media">
                {%- if product.featured_image -%}
                  {{ product.featured_image | image_url: width: 800 | image_tag: loading: 'lazy', alt: product.title }}
                {%- else -%}
                  {{ 'product-1' | placeholder_svg_tag }}
                {%- endif -%}
              </div>
              <div class="fct__info">
                <h3 class="fct__title">{{ product.title }}</h3>
                <p class="fct__price">
                  {{ product.price | money }}
                  {%- if product.compare_at_price > product.price %} <s>{{ product.compare_at_price | money }}</s>{% endif -%}
                </p>
                {%- for option in product.options_with_values -%}
                  {%- assign opt = option.name | downcase -%}
                  {%- if opt == 'color' or opt == 'colour' -%}
                    <ul class="fct__swatches">
                      {%- for value in option.values limit: max_swatches -%}
                        {%- liquid
                          assign bg = value | handleize | replace: '-', ''
                          if value.swatch.color
                            assign bg = value.swatch.color
                          endif
                          assign sw_img = ''
                          if value.swatch.image
                            assign sw_img = value.swatch.image | image_url: width: 64
                          endif
                          assign v_img = ''
                          if value.variant.featured_image
                            assign v_img = value.variant.featured_image | image_url: width: 800
                          endif
                        -%}
                        <li class="fct__swatch" title="{{ value | escape }}"
                          style="background-color:{{ bg }};{% if sw_img != '' %}background-image:url('{{ sw_img }}');{% endif %}"
                          {% if v_img != '' %}data-image="{{ v_img }}"{% endif %}></li>
                      {%- endfor -%}
                      {%- if option.values.size > max_swatches -%}
                        <li class="fct__more">+ {{ option.values.size | minus: max_swatches }}</li>
                      {%- endif -%}
                    </ul>
                    {%- break -%}
                  {%- endif -%}
                {%- endfor -%}
              </div>
            </a>
          {%- else -%}
            <p>Collection "{{ handle }}" not found or empty.</p>
          {%- endfor -%}
        </div>
      </div>
    {%- endfor -%}
  </div>
</div>

<script>
  (function () {
    var root = document.getElementById('fct-custom');
    if (!root) return;
    root.addEventListener('click', function (e) {
      var tab = e.target.closest('.fct__tab');
      if (!tab) return;
      var id = tab.dataset.tab;
      root.querySelectorAll('.fct__tab').forEach(function (t) { t.classList.toggle('is-active', t === tab); });
      root.querySelectorAll('.fct__panel').forEach(function (p) { p.classList.toggle('is-active', p.dataset.panel === id); });
    });
    root.querySelectorAll('.fct__swatch[data-image]').forEach(function (sw) {
      var img = sw.closest('.fct__card').querySelector('.fct__media img');
      if (!img) return;
      var show = function () { img.removeAttribute('srcset'); img.src = sw.dataset.image; };
      sw.addEventListener('mouseenter', show);
      sw.addEventListener('click', function (e) { e.preventDefault(); show(); });
    });
  })();
</script>
