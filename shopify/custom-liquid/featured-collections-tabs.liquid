{%- liquid
  # ====== EDIT THESE ======
  assign heading = 'Featured Collections'
  assign subheading = 'Discover our newest arrivals, best sellers, and exclusive offers—all in one place.'
  assign tab_labels = 'Best Sellers|New Arrival|On Sale' | split: '|'
  assign tab_handles = 'best-seller|new-arrivals|up-tp-50-off' | split: '|'
  assign max_products = 20
  assign max_swatches = 4
  # ========================
-%}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;700&display=swap" rel="stylesheet">

<style>
  #fct-custom { --gap:24px; --per-view:5; background:#f7f8fc; padding:40px 0 60px; }
  #fct-custom .fct__inner { max-width:1400px; margin:0 auto; padding:0 16px; }
  #fct-custom .fct__heading { text-align:center !important; margin:0 0 16px !important; font-family:'DM Sans',sans-serif !important; font-size:clamp(16px,2vw,26px) !important; font-weight:400 !important; letter-spacing:-.02em !important; text-transform:none !important; color:#111 !important; }
  #fct-custom .fct__sub { text-align:center; margin:0 0 40px; font-size:18px; color:#111; }

  /* Tabs */
  #fct-custom .fct__tabs { display:flex; justify-content:center; flex-wrap:wrap; gap:20px; margin-bottom:48px; }
  #fct-custom .fct__tab {
    -webkit-appearance:none !important; appearance:none !important;
    min-width:0 !important; min-height:0 !important; height:auto !important; width:auto !important;
    padding:12px 20px !important; margin:0 !important;
    border-radius:8px !important; border:1px solid #FFEAD7 !important;
    background:#FFEAD7 !important; background-image:none !important; box-shadow:none !important; outline:none;
    color:#111 !important; font-family:inherit; font-size:18px !important; font-weight:700 !important;
    letter-spacing:0 !important; line-height:1.2 !important; text-transform:uppercase !important;
    cursor:pointer; transition:none !important;
  }
  #fct-custom .fct__tab::before, #fct-custom .fct__tab::after { display:none !important; content:none !important; }
  #fct-custom .fct__tab:hover, #fct-custom .fct__tab:focus { background:#FFEAD7 !important; color:#111 !important; opacity:1 !important; transform:none !important; }
  #fct-custom .fct__tab.is-active { border-color:#111 !important; }

  /* Slider */
  #fct-custom .fct__panel { display:none; position:relative; }
  #fct-custom .fct__panel.is-active { display:block; }
  #fct-custom .fct__track {
    display:flex; gap:var(--gap); overflow-x:auto; scroll-snap-type:x mandatory; scroll-behavior:smooth;
    -webkit-overflow-scrolling:touch; scrollbar-width:none; padding-bottom:4px;
  }
  #fct-custom .fct__track::-webkit-scrollbar { display:none; }
  #fct-custom .fct__card {
    flex:0 0 calc((100% - (var(--per-view) - 1) * var(--gap)) / var(--per-view));
    min-width:0; scroll-snap-align:start; text-decoration:none !important; color:#111 !important; display:block;
  }
  #fct-custom .fct__arrow {
    -webkit-appearance:none !important; appearance:none !important;
    position:absolute; top:calc(var(--img-h, 120px)); transform:translateY(-50%) !important;
    width:44px !important; height:44px !important; min-width:0 !important; min-height:0 !important; padding:0 !important;
    border-radius:50% !important; border:none !important; box-shadow:0 2px 10px rgba(0,0,0,.12) !important;
    background:#fff !important; color:#111 !important; font-size:22px !important; line-height:1 !important;
    display:flex !important; align-items:center; justify-content:center; cursor:pointer; z-index:2;
  }
  #fct-custom .fct__arrow::before, #fct-custom .fct__arrow::after { display:none !important; content:none !important; }
  #fct-custom .fct__arrow[disabled] { opacity:0 !important; pointer-events:none; }
  #fct-custom .fct__arrow--prev { left:-12px; }
  #fct-custom .fct__arrow--next { right:-12px; }

  /* Card */
  #fct-custom .fct__media { aspect-ratio:1/1; overflow:hidden; border-radius:20px; background:#f1cfa8; }
  #fct-custom .fct__media img, #fct-custom .fct__media svg { width:100%; height:100%; object-fit:cover; display:block; transition:transform .4s ease; }
  #fct-custom .fct__card:hover .fct__media img { transform:scale(1.04); }
  #fct-custom .fct__info { padding:16px 4px 0; }
  #fct-custom .fct__title {
    margin:0 0 6px !important; font-family:'DM Sans',sans-serif !important; font-size:16px !important; font-weight:500 !important;
    line-height:1.3 !important; letter-spacing:0 !important; text-transform:none !important; color:#111 !important;
    white-space:nowrap; overflow:hidden; text-overflow:ellipsis;
  }
  #fct-custom .fct__price { margin:0 0 12px !important; font-size:14px !important; color:#111 !important; }
  #fct-custom .fct__price s { opacity:.5; margin-left:6px; }
  #fct-custom .fct__swatches { display:flex; align-items:center; flex-wrap:nowrap; gap:8px; list-style:none; margin:0; padding:0; }
  #fct-custom .fct__swatch { flex:0 0 auto; width:24px; height:24px; border-radius:50%; cursor:pointer; border:1px solid rgba(0,0,0,.15); background-size:cover; background-position:center; }
  #fct-custom .fct__more { flex:0 0 auto; white-space:nowrap; font-size:14px; margin-left:2px; }

  @media (max-width:989px) { #fct-custom { --per-view:3; --gap:20px; } }
  @media (max-width:749px) {
    #fct-custom { --per-view:2; --gap:14px; }
    #fct-custom .fct__tabs { gap:10px; margin-bottom:28px; }
    #fct-custom .fct__tab { font-size:14px !important; padding:10px 14px !important; }
    #fct-custom .fct__title { font-size:14px !important; }
    #fct-custom .fct__swatch { width:20px; height:20px; }
    #fct-custom .fct__arrow { display:none !important; }
  }
</style>

<div class="fct" id="fct-custom">
  <div class="fct__inner">
    <h2 class="fct__heading">{{ heading }}</h2>
    <p class="fct__sub">{{ subheading }}</p>

    <div class="fct__tabs">
      {%- for label in tab_labels -%}
        <button type="button" class="fct__tab{% if forloop.first %} is-active{% endif %}" data-tab="{{ forloop.index }}">{{ label }}</button>
      {%- endfor -%}
    </div>

    {%- for handle in tab_handles -%}
      {%- assign col = collections[handle] -%}
      <div class="fct__panel{% if forloop.first %} is-active{% endif %}" data-panel="{{ forloop.index }}">
        <button type="button" class="fct__arrow fct__arrow--prev" aria-label="Previous">&#8249;</button>
        <div class="fct__track">
          {%- for product in col.products limit: max_products -%}
            <a href="{{ product.url }}" class="fct__card">
              <div class="fct__media">
                {%- if product.featured_image -%}
                  {{ product.featured_image | image_url: width: 600 | image_tag: loading: 'lazy', alt: product.title }}
                {%- else -%}
                  {{ 'product-1' | placeholder_svg_tag }}
                {%- endif -%}
              </div>
              <div class="fct__info">
                <h3 class="fct__title" title="{{ product.title | escape }}">{{ product.title }}</h3>
                <p class="fct__price">
                  {{ product.price | money }}
                  {%- if product.compare_at_price > product.price %} <s>{{ product.compare_at_price | money }}</s>{% endif -%}
                </p>
                {%- for option in product.options_with_values -%}
                  {%- assign opt = option.name | downcase -%}
                  {%- if opt == 'color' or opt == 'colour' -%}
                    <ul class="fct__swatches">
                      {%- for value in option.values limit: max_swatches -%}
                        {%- liquid
                          assign bg = value | handleize | replace: '-', ''
                          if value.swatch.color
                            assign bg = value.swatch.color
                          endif
                          assign sw_img = ''
                          if value.swatch.image
                            assign sw_img = value.swatch.image | image_url: width: 64
                          endif
                          assign v_img = ''
                          if value.variant.featured_image
                            assign v_img = value.variant.featured_image | image_url: width: 600
                          endif
                        -%}
                        <li class="fct__swatch" title="{{ value | escape }}"
                          style="background-color:{{ bg }};{% if sw_img != '' %}background-image:url('{{ sw_img }}');{% endif %}"
                          {% if v_img != '' %}data-image="{{ v_img }}"{% endif %}></li>
                      {%- endfor -%}
                      {%- if option.values.size > max_swatches -%}
                        <li class="fct__more">+{{ option.values.size | minus: max_swatches }}</li>
                      {%- endif -%}
                    </ul>
                    {%- break -%}
                  {%- endif -%}
                {%- endfor -%}
              </div>
            </a>
          {%- else -%}
            <p>Collection "{{ handle }}" not found or empty.</p>
          {%- endfor -%}
        </div>
        <button type="button" class="fct__arrow fct__arrow--next" aria-label="Next">&#8250;</button>
      </div>
    {%- endfor -%}
  </div>
</div>

<script>
  (function () {
    var root = document.getElementById('fct-custom');
    if (!root) return;

    function update(panel) {
      var track = panel.querySelector('.fct__track');
      var card = track.querySelector('.fct__card .fct__media');
      if (card) panel.style.setProperty('--img-h', (card.offsetHeight / 2) + 'px');
      var max = track.scrollWidth - track.clientWidth - 2;
      panel.querySelector('.fct__arrow--prev').disabled = track.scrollLeft <= 2;
      panel.querySelector('.fct__arrow--next').disabled = track.scrollLeft >= max;
    }

    root.querySelectorAll('.fct__panel').forEach(function (panel) {
      var track = panel.querySelector('.fct__track');
      var step = function () {
        var card = track.querySelector('.fct__card');
        var gap = parseFloat(getComputedStyle(track).columnGap) || 0;
        return card ? card.offsetWidth + gap : track.clientWidth;
      };
      panel.querySelector('.fct__arrow--prev').addEventListener('click', function () { track.scrollBy({ left: -step(), behavior: 'smooth' }); });
      panel.querySelector('.fct__arrow--next').addEventListener('click', function () { track.scrollBy({ left: step(), behavior: 'smooth' }); });
      track.addEventListener('scroll', function () { update(panel); }, { passive: true });
    });

    function refresh() {
      var active = root.querySelector('.fct__panel.is-active');
      if (active) update(active);
    }
    window.addEventListener('resize', refresh);
    window.addEventListener('load', refresh);
    refresh();

    root.querySelector('.fct__tabs').addEventListener('click', function (e) {
      var tab = e.target.closest('.fct__tab');
      if (!tab) return;
      var id = tab.dataset.tab;
      root.querySelectorAll('.fct__tab').forEach(function (t) { t.classList.toggle('is-active', t === tab); });
      root.querySelectorAll('.fct__panel').forEach(function (p) { p.classList.toggle('is-active', p.dataset.panel === id); });
      refresh();
    });

    root.querySelectorAll('.fct__swatch[data-image]').forEach(function (sw) {
      var img = sw.closest('.fct__card').querySelector('.fct__media img');
      if (!img) return;
      var show = function () { img.removeAttribute('srcset'); img.src = sw.dataset.image; };
      sw.addEventListener('mouseenter', show);
      sw.addEventListener('click', function (e) { e.preventDefault(); show(); });
    });
  })();
</script>
