{%- comment -%}
  Featured Collections (tabs)
  Heading + subheading, tab buttons (one per block), and a product grid
  per tab with image, title, price and color swatches (+N overflow).
{%- endcomment -%}

{%- liquid
  assign sid = section.id
  assign max_swatches = section.settings.max_swatches
-%}

<style>
  #fct-{{ sid }} {
    background: {{ section.settings.bg_color }};
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
  }
  #fct-{{ sid }} .fct__inner { max-width: 1400px; margin: 0 auto; padding: 0 16px; }
  #fct-{{ sid }} .fct__heading {
    text-align: center; margin: 0 0 16px;
    font-size: clamp(32px, 4vw, 52px); font-weight: 400; letter-spacing: -0.02em;
    color: {{ section.settings.text_color }};
  }
  #fct-{{ sid }} .fct__sub {
    text-align: center; margin: 0 0 40px; font-size: 18px;
    color: {{ section.settings.text_color }};
  }
  #fct-{{ sid }} .fct__tabs {
    display: flex; justify-content: center; flex-wrap: wrap; gap: 20px; margin-bottom: 64px;
  }
  #fct-{{ sid }} .fct__tab {
    padding: 12px 20px; border-radius: 8px; cursor: pointer;
    font-size: 18px; font-weight: 700; text-transform: uppercase;
    background: transparent;
    border: 1px solid {{ section.settings.tab_bg }};
    color: {{ section.settings.tab_bg }};
    transition: background .2s, color .2s;
  }
  #fct-{{ sid }} .fct__tab:hover { color: {{ section.settings.tab_text }}; }
  #fct-{{ sid }} .fct__tab.is-active {
    background: {{ section.settings.tab_bg }};
    color: {{ section.settings.tab_text }};
  }
  #fct-{{ sid }} .fct__panel { display: none; }
  #fct-{{ sid }} .fct__panel.is-active { display: block; }
  #fct-{{ sid }} .fct__grid {
    display: grid; gap: 32px;
    grid-template-columns: repeat({{ section.settings.columns_desktop }}, minmax(0, 1fr));
  }
  #fct-{{ sid }} .fct__card { text-decoration: none; color: {{ section.settings.text_color }}; }
  #fct-{{ sid }} .fct__media {
    position: relative; aspect-ratio: 1 / 1; overflow: hidden;
    border-radius: {{ section.settings.image_radius }}px;
    background: {{ section.settings.image_bg }};
  }
  #fct-{{ sid }} .fct__media img {
    width: 100%; height: 100%; object-fit: cover; display: block;
    transition: transform .4s ease, opacity .2s;
  }
  #fct-{{ sid }} .fct__card:hover .fct__media img { transform: scale(1.04); }
  #fct-{{ sid }} .fct__badge {
    position: absolute; top: 12px; left: 12px; padding: 4px 10px; border-radius: 6px;
    background: #c62828; color: #fff; font-size: 12px; font-weight: 700;
  }
  #fct-{{ sid }} .fct__info { padding: 24px 5px 0; }
  #fct-{{ sid }} .fct__title { margin: 0 0 8px; font-size: 22px; font-weight: 400; }
  #fct-{{ sid }} .fct__price { margin: 0 0 16px; font-size: 16px; }
  #fct-{{ sid }} .fct__price s { opacity: .5; margin-left: 6px; }
  #fct-{{ sid }} .fct__swatches { display: flex; align-items: center; gap: 10px; list-style: none; margin: 0; padding: 0; }
  #fct-{{ sid }} .fct__swatch {
    width: 32px; height: 32px; border-radius: 50%; cursor: pointer;
    border: 1px solid rgba(0,0,0,.15); background-size: cover; background-position: center;
  }
  #fct-{{ sid }} .fct__more { font-size: 18px; margin-left: 4px; }

  @media (max-width: 989px) {
    #fct-{{ sid }} .fct__grid { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 20px; }
  }
  @media (max-width: 749px) {
    #fct-{{ sid }} .fct__tabs { gap: 10px; margin-bottom: 32px; }
    #fct-{{ sid }} .fct__tab { font-size: 14px; padding: 10px 14px; }
    #fct-{{ sid }} .fct__grid {
      grid-template-columns: repeat({{ section.settings.columns_mobile }}, minmax(0, 1fr)); gap: 16px;
    }
    #fct-{{ sid }} .fct__title { font-size: 17px; }
    #fct-{{ sid }} .fct__swatch { width: 24px; height: 24px; }
  }
</style>

<section id="fct-{{ sid }}" class="fct">
  <div class="fct__inner">
    {%- if section.settings.heading != blank -%}
      <h2 class="fct__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}
    {%- if section.settings.subheading != blank -%}
      <p class="fct__sub">{{ section.settings.subheading }}</p>
    {%- endif -%}

    <div class="fct__tabs" role="tablist">
      {%- for block in section.blocks -%}
        <button
          type="button"
          class="fct__tab{% if forloop.first %} is-active{% endif %}"
          role="tab"
          aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
          data-tab="{{ block.id }}"
          {{ block.shopify_attributes }}
        >
          {{ block.settings.label | default: block.settings.collection.title }}
        </button>
      {%- endfor -%}
    </div>

    {%- for block in section.blocks -%}
      {%- assign collection = block.settings.collection -%}
      <div class="fct__panel{% if forloop.first %} is-active{% endif %}" role="tabpanel" data-panel="{{ block.id }}">
        <div class="fct__grid">
          {%- if collection != blank and collection.products_count > 0 -%}
            {%- for product in collection.products limit: section.settings.products_to_show -%}
              <a href="{{ product.url }}" class="fct__card">
                <div class="fct__media">
                  {%- if product.featured_image -%}
                    {{
                      product.featured_image
                      | image_url: width: 800
                      | image_tag: loading: 'lazy', widths: '300, 500, 800', sizes: '(min-width: 990px) 20vw, 50vw', class: 'fct__img', alt: product.title
                    }}
                  {%- else -%}
                    {{ 'product-1' | placeholder_svg_tag }}
                  {%- endif -%}
                  {%- if section.settings.show_sale_badge and product.compare_at_price > product.price -%}
                    <span class="fct__badge">{{ 'products.product.on_sale' | t | default: 'Sale' }}</span>
                  {%- endif -%}
                </div>

                <div class="fct__info">
                  <h3 class="fct__title">{{ product.title }}</h3>
                  <p class="fct__price">
                    {{ product.price | money }}
                    {%- if product.compare_at_price > product.price -%}
                      <s>{{ product.compare_at_price | money }}</s>
                    {%- endif -%}
                  </p>

                  {%- for option in product.options_with_values -%}
                    {%- assign opt_name = option.name | downcase -%}
                    {%- if opt_name == 'color' or opt_name == 'colour' -%}
                      <ul class="fct__swatches">
                        {%- for value in option.values limit: max_swatches -%}
                          {%- liquid
                            assign bg = value | handleize | replace: '-', ''
                            if value.swatch.color
                              assign bg = value.swatch.color
                            endif
                            assign swatch_img = blank
                            if value.swatch.image
                              assign swatch_img = value.swatch.image | image_url: width: 64
                            endif
                            assign variant_img = blank
                            if value.variant.featured_image
                              assign variant_img = value.variant.featured_image | image_url: width: 800
                            endif
                          -%}
                          <li
                            class="fct__swatch"
                            title="{{ value | escape }}"
                            style="background-color: {{ bg }};{% if swatch_img != blank %} background-image: url('{{ swatch_img }}');{% endif %}"
                            {% if variant_img != blank %}data-image="{{ variant_img }}"{% endif %}
                          ></li>
                        {%- endfor -%}
                        {%- if option.values.size > max_swatches -%}
                          <li class="fct__more">+ {{ option.values.size | minus: max_swatches }}</li>
                        {%- endif -%}
                      </ul>
                      {%- break -%}
                    {%- endif -%}
                  {%- endfor -%}
                </div>
              </a>
            {%- endfor -%}
          {%- else -%}
            {%- for i in (1..5) -%}
              <div class="fct__card">
                <div class="fct__media">{{ 'product-1' | placeholder_svg_tag }}</div>
                <div class="fct__info">
                  <h3 class="fct__title">Product title</h3>
                  <p class="fct__price">{{ 34900 | money }}</p>
                </div>
              </div>
            {%- endfor -%}
          {%- endif -%}
        </div>
      </div>
    {%- endfor -%}
  </div>
</section>

<script>
  (function () {
    var root = document.getElementById('fct-{{ sid }}');
    if (!root) return;

    // Tab switching
    root.addEventListener('click', function (e) {
      var tab = e.target.closest('.fct__tab');
      if (!tab) return;
      var id = tab.getAttribute('data-tab');
      root.querySelectorAll('.fct__tab').forEach(function (t) {
        var on = t === tab;
        t.classList.toggle('is-active', on);
        t.setAttribute('aria-selected', on);
      });
      root.querySelectorAll('.fct__panel').forEach(function (p) {
        p.classList.toggle('is-active', p.getAttribute('data-panel') === id);
      });
    });

    // Swatch hover/click swaps the card image to that variant's image
    root.querySelectorAll('.fct__swatch[data-image]').forEach(function (sw) {
      var card = sw.closest('.fct__card');
      var img = card && card.querySelector('.fct__media img');
      if (!img) return;
      if (!img.dataset.original) {
        img.dataset.original = img.currentSrc || img.src;
      }
      var show = function () { img.removeAttribute('srcset'); img.src = sw.dataset.image; };
      sw.addEventListener('mouseenter', show);
      sw.addEventListener('click', function (e) { e.preventDefault(); show(); });
    });

    // Theme editor: select the matching tab when a block is selected
    document.addEventListener('shopify:block:select', function (e) {
      var tab = root.querySelector('.fct__tab[data-tab="' + e.detail.blockId + '"]');
      if (tab) tab.click();
    });
  })();
</script>

{% schema %}
{
  "name": "Featured collections tabs",
  "tag": "div",
  "class": "section-featured-collections-tabs",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Featured Collections" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Discover our newest arrivals, best sellers, and exclusive offers—all in one place." },
    { "type": "range", "id": "products_to_show", "label": "Products per tab", "min": 2, "max": 20, "step": 1, "default": 5 },
    { "type": "range", "id": "columns_desktop", "label": "Columns on desktop", "min": 2, "max": 6, "step": 1, "default": 5 },
    { "type": "select", "id": "columns_mobile", "label": "Columns on mobile", "default": "2",
      "options": [ { "value": "1", "label": "1" }, { "value": "2", "label": "2" } ] },
    { "type": "range", "id": "max_swatches", "label": "Max color swatches before \"+N\"", "min": 1, "max": 10, "step": 1, "default": 4 },
    { "type": "checkbox", "id": "show_sale_badge", "label": "Show sale badge", "default": false },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#f7f8fc" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#111111" },
    { "type": "color", "id": "tab_bg", "label": "Active tab background", "default": "#f3eadc" },
    { "type": "color", "id": "tab_text", "label": "Active tab text", "default": "#111111" },
    { "type": "color", "id": "image_bg", "label": "Image background", "default": "#f1cfa8" },
    { "type": "range", "id": "image_radius", "label": "Image corner radius", "min": 0, "max": 40, "step": 2, "unit": "px", "default": 20 },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 40 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 60 }
  ],
  "blocks": [
    {
      "type": "tab",
      "name": "Tab",
      "settings": [
        { "type": "text", "id": "label", "label": "Tab label", "default": "Best Sellers" },
        { "type": "collection", "id": "collection", "label": "Collection" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Featured collections tabs",
      "blocks": [
        { "type": "tab", "settings": { "label": "Best Sellers" } },
        { "type": "tab", "settings": { "label": "New Arrival" } },
        { "type": "tab", "settings": { "label": "On Sale" } }
      ]
    }
  ]
}
{% endschema %}
