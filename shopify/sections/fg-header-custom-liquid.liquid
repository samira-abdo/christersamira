{%- assign is_ar = false -%}
{%- if request.locale.iso_code contains 'ar' -%}{%- assign is_ar = true -%}{%- endif -%}

{%- if routes.root_url == '/' -%}
  {%- assign lp = '' -%}
{%- else -%}
  {%- assign lp = routes.root_url -%}
{%- endif -%}

{%- comment -%}
  Each link lists several possible collection handles (the UAE and
  Lebanon stores name some collections differently). The first handle that
  exists in the current store is used, so the same code works in both stores.
  If none is found, the link uses the first handle in its list.
{%- endcomment -%}

{%- capture fg_nav_links -%}
  {%- capture fg_defaults -%}
new-arrivals,new-arrival|New!|جديد!;;
hand-bag,hand-bags,handbags,handbag|Handbags|حقائب اليد;;
shoulder-bag,shoulder-bags|Shoulder Bags|حقائب الكتف;;
crossbody-bag,crossbody-bags,cross-body-bags|Crossbody Bags|حقائب كروس بودي;;
travel-bags,travel-bag|Travel Bags|حقائب السفر;;
cosmetic-storage-bags,cosmetic-and-storage-bags,cosmetic-bags|Cosmetic & Storage Bags|حقائب التجميل والتخزين;;
laptop-bags,laptop-bag|Laptop Bags|حقائب اللابتوب;;
specialty-bags,speciality-bags,specialty-bag|Specialty Bags|حقائب مميزة;;
sport-bags,sports-bags,sport-bag|Sport Bags|الحقائب الرياضية;;
tote-bags,tote-bag|Tote Bags|حقائب توت;;
bag-assessories,bag-accessories,accessories|Bag Accessories|إكسسوارات الحقائب
  {%- endcapture -%}
  {%- assign fg_items = fg_defaults | split: ';;' -%}
  {%- for fg_item in fg_items -%}
    {%- assign fg_parts = fg_item | strip | split: '|' -%}
    {%- assign fg_handles = fg_parts[0] | split: ',' -%}
    {%- assign fg_found = nil -%}
    {%- for fg_handle in fg_handles -%}
      {%- assign fg_col = collections[fg_handle] -%}
      {%- if fg_col.id != blank -%}
        {%- assign fg_found = fg_col -%}
        {%- break -%}
      {%- endif -%}
    {%- endfor -%}
    {%- if fg_found -%}
      {%- assign fg_href = fg_found.url -%}
    {%- else -%}
      {%- assign fg_href = lp | append: '/collections/' | append: fg_handles[0] -%}
    {%- endif -%}
<a href="{{ fg_href }}">{% if is_ar %}{{ fg_parts[2] }}{% else %}{{ fg_parts[1] | escape }}{% endif %}</a>
  {%- endfor -%}
{%- endcapture -%}

<input type="checkbox" id="fg-drawer-toggle" class="fg-drawer-toggle">

<header class="fg-header">

<div class="fg-page-width">

<div class="fg-header-main">

<!-- LEFT : search (desktop) / burger + account (mobile) -->

<div class="fg-header-left">

<label for="fg-drawer-toggle" class="fg-burger" aria-label="{% if is_ar %}فتح القائمة{% else %}Open menu{% endif %}">
<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#111" stroke-width="1.5"><path d="M3 6h18M3 12h18M3 18h18"/></svg>
</label>

<a href="{{ routes.account_url }}" class="fg-icon fg-account-mobile" aria-label="{% if is_ar %}الحساب{% else %}Account{% endif %}">
<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#111" stroke-width="1.5"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 3.6-6.5 8-6.5s8 2.5 8 6.5"/></svg>
</a>

<div class="fg-search">
<form action="{{ routes.search_url }}" method="get">
<input type="hidden" name="type" value="product">
<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#111" stroke-width="1.5"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3"/></svg>
<input type="search" name="q" placeholder="{% if is_ar %}بحث{% else %}Search{% endif %}">
</form>
</div>

</div>

<!-- CENTER : logo -->

<div class="fg-logo">
<a href="{{ routes.root_url }}" aria-label="Fungoofun home">
<img src="https://cdn.shopify.com/s/files/1/0947/2357/2083/files/fungoofun_logo_1.webp?v=1789316550" alt="Fungoofun" style="height:44px;width:auto;">
</a>
</div>

<!-- RIGHT : icons -->

<div class="fg-header-right">

<a href="{{ lp }}/pages/wishlist" class="fg-icon" aria-label="{% if is_ar %}المفضلة{% else %}Wishlist{% endif %}">
<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#111" stroke-width="1.5"><path d="M12 21s-7.5-4.8-9.5-9C1 8.6 3 5 6.5 5c2 0 3.5 1 4.5 2.5C12 6 13.5 5 15.5 5 19 5 21 8.6 20.5 12c-1 4.2-8.5 9-8.5 9z"/></svg>
</a>

<a href="{{ routes.account_url }}" class="fg-icon fg-account-desktop" aria-label="{% if is_ar %}الحساب{% else %}Account{% endif %}">
<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#111" stroke-width="1.5"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 3.6-6.5 8-6.5s8 2.5 8 6.5"/></svg>
</a>

<a href="{{ routes.cart_url }}" class="fg-icon fg-cart" aria-label="{% if is_ar %}سلة التسوق{% else %}Cart{% endif %}">
<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#111" stroke-width="1.5"><path d="M6 8h12l1 13H5L6 8z"/><path d="M9 8V6a3 3 0 0 1 6 0v2"/></svg>
{% if cart.item_count > 0 %}
<span class="fg-cart-count">{{ cart.item_count }}</span>
{% endif %}
</a>

</div>

</div>

<!-- DESKTOP NAV -->

<nav class="fg-nav">
{{ fg_nav_links }}
</nav>

</div>

</header>

<!-- MOBILE DRAWER -->

<label for="fg-drawer-toggle" class="fg-drawer-overlay"></label>

<aside class="fg-drawer{% if is_ar %} fg-rtl{% endif %}">

<div class="fg-drawer-head">
<span>{% if is_ar %}القائمة{% else %}Menu{% endif %}</span>
<label for="fg-drawer-toggle" class="fg-drawer-close" aria-label="{% if is_ar %}إغلاق القائمة{% else %}Close menu{% endif %}">
<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#111" stroke-width="1.5"><path d="M5 5l14 14M19 5L5 19"/></svg>
</label>
</div>

<div class="fg-drawer-search">
<form action="{{ routes.search_url }}" method="get">
<input type="hidden" name="type" value="product">
<input type="search" name="q" placeholder="{% if is_ar %}بحث{% else %}Search{% endif %}">
<button type="submit" aria-label="{% if is_ar %}بحث{% else %}Search{% endif %}">
<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#111" stroke-width="1.5"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3"/></svg>
</button>
</form>
</div>

<nav class="fg-drawer-nav">
{{ fg_nav_links }}
</nav>

<div class="fg-drawer-foot">
<a href="{{ routes.account_url }}">{% if is_ar %}حسابي{% else %}My Account{% endif %}</a>
<a href="{{ lp }}/pages/wishlist">{% if is_ar %}المفضلة{% else %}Wishlist{% endif %}</a>
</div>

</aside>

<script>
(function(){
  function moveDrawer(){
    var t = document.getElementById('fg-drawer-toggle');
    var o = document.querySelector('.fg-drawer-overlay');
    var d = document.querySelector('.fg-drawer');
    if(t && o && d){
      document.body.appendChild(t);
      document.body.appendChild(o);
      document.body.appendChild(d);
    }
  }
  if(document.readyState === 'loading'){
    document.addEventListener('DOMContentLoaded', moveDrawer);
  } else {
    moveDrawer();
  }
})();
</script>

<style>
#shopify-section-{{ section.id }}{
    transform:none !important;
    animation:none !important;
    filter:none !important;
    perspective:none !important;
    margin:0 !important;
    padding:0 !important;
    max-width:none !important;
    width:100% !important;
}

#shopify-section-{{ section.id }} > *{
    max-width:none !important;
}

.fg-header{
    background:#Ffffff;
    color:#111;
    position:sticky;
    top:0;
    z-index:90;
    border-bottom:1px solid rgba(0,0,0,.08);
    width:100vw;
    margin-left:calc(50% - 50vw);
    margin-right:calc(50% - 50vw);
}

.fg-header *,
.fg-drawer *{
    box-sizing:border-box;
}

.fg-page-width{
    max-width:1400px;
    margin:0 auto;
    padding:0 40px;
}

/* =========================
   MAIN ROW
========================= */

.fg-header-main{
    display:grid;
    grid-template-columns:1fr auto 1fr;
    align-items:center;
    gap:20px;
    padding:20px 0;
}

.fg-header-left{
    display:flex;
    align-items:center;
    gap:16px;
}

.fg-header-right{
    display:flex;
    align-items:center;
    justify-content:flex-end;
    gap:18px;
}

/* =========================
   SEARCH
========================= */

.fg-search form{
    display:flex;
    align-items:center;
    gap:10px;
    background:#F0EEEC;
    height:44px;
    width:100%;
    max-width:250px;
    padding:0 14px;
}

.fg-search svg{
    flex-shrink:0;
}

.fg-search input{
    border:none;
    background:transparent;
    outline:none;
    width:100%;
    font-size:14px;
    color:#111;
}

.fg-search input::placeholder{
    color:#777;
}

/* =========================
   LOGO
========================= */

.fg-logo a{
    display:flex;
    align-items:center;
    justify-content:center;
    text-decoration:none;
}

.fg-header .fg-logo img{
    height:44px !important;
    max-height:44px !important;
    width:auto !important;
    max-width:260px !important;
    display:block;
}

/* =========================
   ICONS
========================= */

.fg-icon{
    display:flex;
    align-items:center;
    justify-content:center;
    position:relative;
    text-decoration:none;
    transition:.25s;
}

.fg-icon:hover{
    opacity:.7;
}

.fg-cart-count{
    position:absolute;
    top:-7px;
    inset-inline-end:-9px;
    min-width:17px;
    height:17px;
    padding:0 4px;
    background:#111;
    color:#fff;
    border-radius:50%;
    font-size:11px;
    font-weight:600;
    display:flex;
    align-items:center;
    justify-content:center;
}

/* =========================
   DESKTOP NAV
========================= */

.fg-nav{
    display:flex;
    justify-content:center;
    flex-wrap:wrap;
    gap:6px 32px;
    padding:6px 0 18px;
}

.fg-nav a{
    color:#111;
    text-decoration:none;
    font-size:13px;
    font-weight:600;
    text-transform:uppercase;
    letter-spacing:.12em;
    padding:6px 0;
    border-bottom:2px solid transparent;
    transition:.25s;
    white-space:nowrap;
}

.fg-nav a:hover{
    border-bottom-color:#111;
}

/* =========================
   MOBILE-ONLY ELEMENTS
========================= */

.fg-drawer-toggle{
    display:none !important;
}

.fg-burger,
.fg-account-mobile{
    display:none;
}

.fg-drawer-overlay,
.fg-drawer{
    display:none;
}

/* =========================
   MOBILE
========================= */

@media(max-width:990px){

.fg-page-width{
    padding:0 16px;
}

.fg-header-main{
    padding:14px 0;
}

.fg-search,
.fg-nav,
.fg-account-desktop{
    display:none;
}

.fg-burger,
.fg-account-mobile{
    display:flex;
    align-items:center;
    cursor:pointer;
}

.fg-header-left{
    gap:14px;
}

.fg-header .fg-logo img{
    height:30px !important;
    max-height:30px !important;
    max-width:160px !important;
}

.fg-header-right{
    gap:14px;
}

/* ---- drawer ---- */

.fg-drawer-overlay{
    display:block;
    position:fixed;
    inset:0;
    background:rgba(0,0,0,.4);
    opacity:0;
    pointer-events:none;
    transition:.3s;
    z-index:9998;
}

.fg-drawer{
    display:flex;
    flex-direction:column;
    position:fixed;
    top:0;
    left:0;
    bottom:0;
    width:85%;
    max-width:360px;
    background:#fff;
    z-index:9999;
    transform:translateX(-100%);
    transition:transform .3s ease;
    overflow-y:auto;
}

/* Arabic: drawer slides in from the right */

.fg-drawer.fg-rtl{
    left:auto;
    right:0;
    transform:translateX(100%);
}

.fg-drawer-toggle:checked ~ .fg-drawer-overlay{
    opacity:1;
    pointer-events:auto;
}

.fg-drawer-toggle:checked ~ .fg-drawer{
    transform:translateX(0);
}

.fg-drawer-head{
    display:flex;
    justify-content:space-between;
    align-items:center;
    padding:18px 20px;
    border-bottom:1px solid rgba(0,0,0,.1);
}

.fg-drawer-head span{
    font-size:14px;
    font-weight:700;
    text-transform:uppercase;
    letter-spacing:.12em;
}

.fg-drawer-close{
    display:flex;
    cursor:pointer;
    padding:4px;
}

.fg-drawer-search{
    padding:16px 20px;
    border-bottom:1px solid rgba(0,0,0,.1);
}

.fg-drawer-search form{
    display:flex;
    align-items:center;
    background:#F0EEEC;
    height:44px;
    padding:0 4px 0 14px;
}

.fg-drawer-search input{
    flex:1;
    border:none;
    background:transparent;
    outline:none;
    font-size:14px;
    color:#111;
    width:auto;
}

.fg-drawer-search button{
    border:none;
    background:transparent;
    display:flex;
    align-items:center;
    padding:10px;
    cursor:pointer;
}

.fg-drawer-nav{
    display:flex;
    flex-direction:column;
    padding:10px 0;
}

.fg-drawer-nav a{
    color:#111;
    text-decoration:none;
    font-size:14px;
    font-weight:600;
    text-transform:uppercase;
    letter-spacing:.1em;
    text-align:start;
    padding:15px 20px;
    border-bottom:1px solid rgba(0,0,0,.06);
}

.fg-drawer-foot{
    margin-top:auto;
    padding:18px 20px 30px;
    border-top:1px solid rgba(0,0,0,.1);
    display:flex;
    flex-direction:column;
    gap:14px;
}

.fg-drawer-foot a{
    color:#111;
    text-decoration:none;
    font-size:14px;
}

}

</style>
